{
  "name": "goose-2fa",
  "private": true,
  "version": "0.1.17",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 6002",
    "build": "tsc -b && vite build -c vite.config.utools.ts --logLevel warn && node utools/scripts/build.js",
    "build:debug": "GOOSE_DEBUG=1 tsc -b && GOOSE_DEBUG=1 vite build -c vite.config.utools.ts && GOOSE_DEBUG=1 node utools/scripts/build.js",
    "mcp:serve": "bun run src/mcp/server.ts",
    "test": "vitest run",
    "test:bridge": "node --test utools/preload.integration.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@dnd-kit/core": "^6",
    "@dnd-kit/modifiers": "^9",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "code-inspector-plugin": "^1.5.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  }
}
